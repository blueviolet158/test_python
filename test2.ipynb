    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    \"name\" : [\"Kim\", \"Lee\", \"Park\", \"Choi\"],\n",
    "    \"score\" : [85, 92, 76, 98]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "print(\"학생  수 :\", len(df))\n",
    "print(\"평균 점수 :\", df[\"score\"].mean())\n",
    "print(\"최고 점수 :\", df[\"score\"].max())\n",
    "print(\"최저 점수 :\", df[\"score\"].min())"
   ]
